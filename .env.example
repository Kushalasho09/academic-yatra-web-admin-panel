# MySQL Database Connection String
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL="mysql://root:password@localhost:3306/academic_yatra_db"

# Admin Authentication Secret
ADMIN_SECRET_KEY="academic_yatra_super_secure_key"

# Port (optional, default 3001)
PORT=3001

# HisabKitab API Configuration
# Documentation: https://zqki873xwy.apidog.io/
HISABKITAB_BASE_URL="https://api.hisabkitab.co"
HISABKITAB_API_KEY="your_hisabkitab_api_key_here"

